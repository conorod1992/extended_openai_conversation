{
  "description": "Reviewed ownership inventory. Changes require policy and regression review; this is not a semantic security proof. Supported direct and aliased YAML/JSON parser calls and conventionally named export/codec boundaries are discovered by AST.",
  "policies": {
    "source_input": "Private source; operational exceptions cross source-free record boundary. Authorised editor feedback may remain detailed.",
    "private_codec": "Lossless private/legacy transport parsing; no sharing projection or credential redaction.",
    "public_projection": "Reviewed sharing inspection; coherent-unit omission, no rendering or remote resolution.",
    "provider_data": "Provider/business data; public failure boundary separate from successful payload semantics.",
    "bundled_data": "Bundled manifest/catalogue/assets; ordinary source-free operational failures.",
    "current_sharing": "Current sharing artifact; shared section projection plus explicit public envelope.",
    "private_backup": "Lossless versioned backup; preserve credentials, source bytes and typed values.",
    "legacy_redacted": "Historical redaction semantics; never silently reinterpret as lossless private data.",
    "transfer_transport": "Admin-only transfer lifecycle; payload confidentiality, bounds and ownership enforced.",
    "snapshot": "Internal source projection; downstream writer selects private or sharing semantics."
  },
