{
  "responses": [
    {
      "type": "function",
      "name": "memory_upsert",
      "description": "Propose a NEW durable fact; never overwrite or bypass a conflict by changing keys. needs_resolution means no write; search and decide what the facts mean.",
      "parameters": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "explicit",
              "implicit"
            ],
            "description": "Descriptive origin only; explicit is not model authorization."
          },
          "subject": {
            "type": "string",
            "description": "Specific person, device or item the assertion concerns; never infer another person's preference."
          },
          "key": {
            "type": "string",
            "maxLength": 160,
            "pattern": "^[a-z0-9_-]+(?:\\.[a-z0-9_-]+)*$",
            "description": "Stable canonical identifier for this exact subject; never change it to evade a conflict."
          },
          "valid_from": {
            "type": "string",
            "description": "ISO 8601 time when the fact became true, if known."
          },
          "scope": {
            "type": "string",
            "enum": [
              "personal",
              "household"
            ]
          },
          "intent": {
            "type": "string",
            "enum": [
              "automatic",
              "user_request"
            ],
            "description": "Your interpretation: user_request only when the current user asks to modify persistent Memory in the target scope; otherwise automatic. Not proof of consent. Omission means automatic; source never authorizes."
          }
        },
        "required": [
          "content",
          "category",
          "source"
        ],
        "additionalProperties": false
      },
      "strict": false
    },
