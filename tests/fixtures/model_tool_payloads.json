        "name": "memory_delete",
        "description": "Delete only specifically identified scoped records using their exact IDs and fresh revisions. Set intent=user_request for current user requests, or automatic for clear obsolete facts in Automatic mode. Confirm before broad deletion.",
        "parameters": {
          "type": "object",
          "properties": {
            "targets": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "memory_id": {
                    "type": "string"
                  },
                  "expected_revision": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "memory_id",
                  "expected_revision"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 50
            },
            "scope": {
              "type": "string",
              "enum": [
                "personal",
                "household"
              ]
            },
            "intent": {
              "type": "string",
              "enum": [
                "automatic",
                "user_request"
              ],
              "description": "Your interpretation: user_request only when the current user asks to modify persistent Memory in the target scope; otherwise automatic. Not proof of consent. Omission means automatic; source never authorizes."
            }
          },
          "required": [
            "targets"
          ],
          "additionalProperties": false
        }
      }
    },
